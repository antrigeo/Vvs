<script>
  const SCRIPT_URL = 'YOUR_APPS_SCRIPT_URL_HERE';

  async function submitForm() {
    const firstName = document.getElementById('firstName').value.trim();
    const lastName  = document.getElementById('lastName').value.trim();
    const phone     = document.getElementById('phone').value.trim();
    const errorMsg  = document.getElementById('errorMsg');

    if (!firstName || !lastName || !phone) {
      errorMsg.textContent = 'Παρακαλώ συμπλήρωσε όλα τα πεδία.';
      errorMsg.classList.add('show');
      setTimeout(() => errorMsg.classList.remove('show'), 3000);
      return;
    }

    errorMsg.classList.remove('show');
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.querySelector('span').innerHTML = '<span class="spinner"></span>Αποστολή...';

    try {
      await fetch(SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ firstName, lastName, phone })
      });

      document.getElementById('formContent').style.display = 'none';
      document.getElementById('successMsg').classList.add('show');

    } catch (err) {
      btn.disabled = false;
      btn.querySelector('span').textContent = 'Καταχώρηση';
      errorMsg.textContent = 'Σφάλμα. Δοκίμασε ξανά.';
      errorMsg.classList.add('show');
    }
  }

  document.addEventListener('keydown', e => { if (e.key === 'Enter') submitForm(); });
</script>

